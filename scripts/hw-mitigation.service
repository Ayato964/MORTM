[Unit]
Description=CPU/GPU hardware mitigation (RAPL limits, boost cap, GPU power cap)
After=multi-user.target nvidia-persistenced.service
Wants=nvidia-persistenced.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/home/takaaki-nagoshi/PycharmProjects/MORTM/scripts/hw_mitigation.sh
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
